#!/bin/sh
set -eu

if [ "$1" != "configure" ]; then
    exit 0
fi

if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
    if [ -e /sys/class/misc/uinput ]; then
        udevadm trigger --sysname-match=uinput || true
    fi
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
fi
if command -v systemd-tmpfiles >/dev/null 2>&1; then
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/strokelet.conf || true
fi

system_ext=/usr/share/gnome-shell/extensions/strokelet@local
for home in /home/*; do
    [ -d "$home" ] || continue
    user=$(basename "$home")
    uid=$(id -u "$user" 2>/dev/null || true)
    [ -n "$uid" ] || continue
    /usr/lib/strokelet/strokelet-mkruntime "$uid" || true
    ext="$home/.local/share/gnome-shell/extensions/strokelet@local"
    marker="$ext/STROKELET_OWNED"
    if [ -f "$marker" ] && [ "$(cat "$marker")" = "strokelet@local" ]; then
        cp -a "$system_ext/." "$ext/"
        printf '%s\n' 'strokelet@local' > "$marker"
        chown -R "$user:$user" "$ext" || true
    fi
    runtime="/run/user/$uid"
    [ -S "$runtime/bus" ] || continue
    runuser -u "$user" -- env \
        XDG_RUNTIME_DIR="$runtime" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
        /usr/lib/strokelet/enable-extension.sh || true
done
